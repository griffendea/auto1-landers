<script>
  if (window.innerWidth > 768) document.getElementById('desktop-nav').style.display = 'flex';
  function selectAge(btn) { document.querySelectorAll('.age-btn').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); }
  function selectMobileAge(btn) { document.querySelectorAll('.mh-age-btn').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); }
  function selectMobilePlan(el) { document.querySelectorAll('.mh-plan').forEach(c=>c.classList.remove('active')); el.classList.add('active'); document.getElementById('mh-price').textContent=el.dataset.price; }
  function selectPlan(el) { document.querySelectorAll('.coverage-card').forEach(c=>c.classList.remove('active')); el.classList.add('active'); }
  function toggleFaq(el) { const item=el.closest('.faq-item'); const isOpen=item.classList.contains('open'); document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open')); if(!isOpen)item.classList.add('open'); }
</script>
